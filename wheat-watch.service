[Unit]
Description=PySURVEILLANCE Field & Facility Surveillance Service
After=network.target sound.target default.target

[Service]
Type=simple
WorkingDirectory=%h/pysurveillance
ExecStart=%h/pysurveillance/.venv/bin/python run.py
Restart=always
RestartSec=3
TimeoutStopSec=5
KillMode=mixed
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=default.target
