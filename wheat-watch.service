[Unit]
Description=Wheat Watch Crop & Field Surveillance Service
After=network.target sound.target default.target

[Service]
Type=simple
WorkingDirectory=/home/sumit/Desktop/survelance
ExecStart=/home/sumit/Desktop/survelance/.venv/bin/python /home/sumit/Desktop/survelance/run.py
Restart=always
RestartSec=3
TimeoutStopSec=3
