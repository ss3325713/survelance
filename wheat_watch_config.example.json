{
  "camera": {
    "device_profile": "auto",
    "source_name": "Network Camera",
    "camera_host": "<CAMERA_IP>",
    "camera_port": 8080,
    "phone_ip": "<CAMERA_IP>",
    "phone_port": 8080,
    "video_endpoint": "/video",
    "snapshot_endpoint": "/shot.jpg",
    "audio_endpoint": "/audio.wav",
    "video_url": "",
    "snapshot_url": "",
    "audio_url": "",
    "audio_source_name": "",
    "username": "",
    "password": "",
    "timeout_sec": 5.0,
    "reconnect_delay_sec": 3.0,
    "reconnect_backoff": 1.5,
    "max_reconnect_delay_sec": 15.0,
    "reconnect_timeout_sec": 60.0
  },
  "server": {
    "host": "0.0.0.0",
    "port": 8000,
    "dashboard_pin": "",
    "dashboard_pin_hash": "",
    "dashboard_pin_salt": "",
    "pin_required": true,
    "session_secret": "",
    "restrict_local_network": true
  },
  "pipeline": {
    "target_width": 640,
    "target_height": 480,
    "motion_fps": 8.0,
    "motion_threshold": 25,
    "min_motion_area": 250,
    "max_motion_percent": 22.0,
    "require_motion_overlap": true,
    "ai_fps": 1.5,
    "detection_confidence": 0.45,
    "min_confidence": 0.45,
    "auto_throttle_cpu": true,
    "cpu_throttle_threshold": 85.0,
    "monkey_model_path": "models/monkey_classifier.onnx"
  },
  "image_controls": {
    "resolution": "640x480",
    "quality": 95,
    "exposure_compensation": 0,
    "gamma": 1.0,
    "brightness": 0,
    "contrast": 1.0,
    "auto_hdr": false,
    "white_balance": "auto",
    "torch": false,
    "night_vision": false
  },
  "flashlight": {
    "mode": "auto",
    "inactivity_timeout_sec": 15.0,
    "lux_threshold": 45.0,
    "min_on_time_sec": 10.0,
    "max_on_time_sec": 120.0
  },
  "video_recording": {
    "enabled": true,
    "inactivity_timeout_sec": 15.0,
    "max_segment_duration_sec": 600.0,
    "recording_fps": 10.0,
    "max_extracted_frames": 6,
    "min_sharpness": 35.0,
    "temp_directory": "storage/temp_recordings"
  },
  "alarm": {
    "sound_enabled": true,
    "volume": 1.0,
    "alarm_on_general_motion": false,
    "alarm_on_unknown_objects": false,
    "alert_categories": [
      "Person",
      "Bird",
      "Animal detected \u2014 species unconfirmed",
      "Other recognized animal",
      "Possible monkey"
    ],
    "cooldowns": {
      "General motion": 15,
      "Person": 30,
      "Bird": 20,
      "Other recognized animal": 25,
      "Animal detected \u2014 species unconfirmed": 25,
      "Possible monkey": 15,
      "Unknown object": 20
    }
  },
  "audio_detection": {
    "enabled": true,
    "rms_threshold": 1800.0,
    "activity_cooldown_sec": 1.0
  },
  "power": {
    "prevent_sleep": true
  },
  "storage": {
    "retention_days": 7,
    "max_storage_mb": 2048
  },
  "push": {
    "enabled": false,
    "browser_audio": true,
    "desktop_notifications": true,
    "push_on_general_motion": false,
    "push_on_unknown_objects": false,
    "min_confidence": 0.35,
    "alert_categories": [
      "Person",
      "Bird",
      "Animal detected \u2014 species unconfirmed",
      "Other recognized animal",
      "Possible monkey"
    ]
  },
  "night_mode": {
    "mode": "auto",
    "auto_threshold": 45.0,
    "hysteresis": 8.0,
    "day": {
      "motion_threshold": 25,
      "min_motion_area": 250,
      "max_motion_percent": 22.0
    },
    "night": {
      "motion_threshold": 18,
      "min_motion_area": 180,
      "max_motion_percent": 30.0
    }
  }
}
